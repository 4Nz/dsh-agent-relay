{
  "name": "dsh-agent-relay",
  "version": "0.1.9",
  "private": true,
  "license": "Apache-2.0",
  "files": [
    "lib",
    "README.en.md",
    "docs/images/showcase/*.png",
    "cordis.patch.yml",
    "skills",
    "scripts/install-skills.mjs",
    "CHANGELOG.md",
    "docs/operations/T0-T1-T3-T7-plugin-release.md"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "scripts": {
    "skills:install": "node scripts/install-skills.mjs",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "release:prepare": "npm run typecheck && npm test && node scripts/release.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "test": "npm run build && node --test test/storage/*.test.js test/adapters/*.test.js test/services/*.test.js test/scripts/*.test.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./storage": {
      "types": "./lib/storage/index.d.ts",
      "import": "./lib/storage/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./team-mode": {
      "types": "./lib/team-mode.d.ts",
      "import": "./lib/team-mode.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2"
  }
}
