{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "lib",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/client.ts",
    "src/client/format.ts",
    "src/client/styles.ts",
    "src/client/drawer.ts",
    "src/client/notifications.ts",
    "src/client/install-drawer.ts",
    "src/client/panel-drawers.ts"
  ]
}
